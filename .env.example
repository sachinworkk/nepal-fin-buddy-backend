APP_ENV=development
DATABASE_URL=postgresql+asyncpg://finbuddy:finbuddy@localhost:5433/finbuddy
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:5173

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Judge model used by tests/eval (deepeval); a strong model is recommended
EVAL_JUDGE_MODEL=openai/gpt-5.4
EXTRACTION_MODEL=qwen/qwen3-vl-8b-instruct
CHAT_MODEL=google/gemma-4-26b-a4b-it

EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBED_DIM=1024

# IRD prize lottery (prize.ird.gov.np). test = local mock; live targets the real portal.
PRIZE_MODE=test
PRIZE_MOCK_URL=http://localhost:8002/api/v1
PRIZE_LIVE_URL=https://prize.ird.gov.np/api/v1
# Live mode is hand-off only: IRD's Turnstile widget rejects other origins, so users
# finish the submission on the portal itself.
PRIZE_PORTAL_URL=https://prize.ird.gov.np
# Optional bumper prize amount (NPR) shown on the Bumper Draw card; the portal publishes none.
# PRIZE_BUMPER_AMOUNT_NPR=
# Cloudflare Turnstile widget rendered by the frontend in test mode only. Defaults are
# Cloudflare's published test keys, which pass on any domain (e.g. localhost).
PRIZE_TURNSTILE_SITEKEY=1x00000000000000000000AA
PRIZE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
PRIZE_MIN_FORM_AGE_SECONDS=5
PRIZE_MAX_FORM_AGE_SECONDS=86400
PRIZE_USER_SUBMIT_INTERVAL_SECONDS=8

STORAGE_DIR=./storage

# MLflow tracing (metadata only: model, tokens, latency, counts; never prompt text).
MLFLOW_ENABLED=false
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT=nepal-fin-buddy
# Also log chat query/answer text on the chat.turn trace (contains financial data).
MLFLOW_LOG_CONTENT=false
